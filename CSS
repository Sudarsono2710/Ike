
/* BACKGROUND */
body {
    margin: 0;
    padding: 0;
    background: linear-gradient(135deg, #fce8f3, #f0edf8, #e7f0e6);
    color: #34445b;
    font-family: Georgia, serif;
    line-height: 1.8;
}

/* HEADER */
header {
    text-align: center;
    padding: 25px 15px;
    background: linear-gradient(135deg, #d9c5e8, #f5d6e7);
    border-bottom: 3px solid #d6bd79;
}

h1 {
    color: #304c70;
    font-size: 32px;
    letter-spacing: 2px;
    margin-top: 10px;
}

/* NAVIGASI */
nav {
    margin-top: 20px;
}

nav a {
    display: inline-block;
    margin: 5px;
    padding: 8px 16px;
    color: #34445b;
    background: #ffffff;
    border-radius: 20px;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    background: #d99ab8;
    color: white;
}

/* BAGIAN KONTEN */
section {
    max-width: 900px;
    margin: 30px auto;
    padding: 25px;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 20px;
    box-shadow: 0 5px 18px rgba(80, 60, 100, 0.12);
}

/* LOGO */
.hero {
    text-align: center;
}

.hero img {
    display: block;
    width: 280px;
    max-width: 90%;
    height: auto;
    margin: 10px auto 25px;
}

/* JUDUL BAGIAN */
h2 {
    color: #71886f;
    text-align: center;
    border-bottom: 2px solid #d6bd79;
    padding-bottom: 10px;
}

/* PARAGRAF */
p {
    font-size: 15px;
    text-align: justify;
}

/* PRESENTASI CANVA */
.canva {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(80, 60, 100, 0.15);
}

.canva iframe {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    border: none;
}

/* LINK CANVA */
.credit {
    text-align: center;
}

.credit a {
    color: #b56c91;
    font-weight: bold;
}

/* FOOTER */
footer {
    padding: 15px;
    text-align: center;
    background: #e4d8ed;
    color: #34445b;
}

/* TAMPILAN HP */
@media (max-width: 600px) {
    h1 {
        font-size: 25px;
    }

    section {
        margin: 18px 12px;
        padding: 18px;
    }

    .hero img {
        width: 230px;
    }

    nav a {
        padding: 7px 12px;
        font-size: 14px;
    }
}
